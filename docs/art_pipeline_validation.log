extends SceneTree
func _initialize():
	var report = {}
	for path in ["res://assets/characters/unitychan_battle/animations/idle.fbx", "res://assets/characters/unitychan_battle/animations/walk.fbx", "res://assets/characters/unitychan_battle/animations/run.fbx", "res://assets/characters/unitychan_battle/animations/slide.fbx", "res://assets/characters/vrm_avatar/avatar_sample_a.glb"]:
		var model = load(path).instantiate()
		var data = []
		_scan(model, model, data)
		var h = HashingContext.new()
		h.start(HashingContext.HASH_SHA256)
		h.update(var_to_bytes(data))
		report[path] = {"sha256": h.finish().hex_encode(), "entries": data.size()}
		model.free()
	var output = FileAccess.open(OS.get_environment("BUNNY_SIGNATURE"), FileAccess.WRITE)
	output.store_string(JSON.stringify(report, "  "))
	output.close()
	print(JSON.stringify(report))
	quit()
func _scan(node: Node, top: Node, data: Array):
	if node is Skeleton3D:
		var bones = []
		for i in node.get_bone_count():
			bones.append([node.get_bone_name(i), node.get_bone_parent(i), node.get_bone_rest(i), node.get_bone_pose(i)])
		data.append([str(top.get_path_to(node)), node.transform, bones])
	if node is MeshInstance3D and node.skin:
		var binds = []
		for i in node.skin.get_bind_count():
			binds.append([node.skin.get_bind_name(i), node.skin.get_bind_bone(i), node.skin.get_bind_pose(i)])
		data.append([str(top.get_path_to(node)), binds])
	if node is AnimationPlayer:
		for name in node.get_animation_list():
			var anim = node.get_animation(name)
			var tracks = []
			for i in anim.get_track_count():
				var keys = []
				for k in anim.track_get_key_count(i):
					keys.append([anim.track_get_key_time(i,k), anim.track_get_key_value(i,k), anim.track_get_key_transition(i,k)])
				tracks.append([anim.track_get_path(i), anim.track_get_type(i), anim.track_get_interpolation_type(i), keys])
			data.append([str(top.get_path_to(node)), name, anim.length, anim.loop_mode, tracks])
	for child in node.get_children(): _scan(child, top, data)

