[resource]
script = ExtResource("1")
mission_id = &"waterworks_run"
display_name = "Water Tower Street / Who Gets the First Bucket"
description = "Tang Kui promised the courtyard water. Shen Yanshuang promised the back lanes a tanker. There is one pump battery, in the west garage. Bring 8kg of free capacity. Install it at the east pump, then choose which valve to open. West: two dressings and the courtyard exit. North: ninety rounds and the loading exit. The south retreat stays open."
objective_definitions = Array[ExtResource("2")]([SubResource("Battery"),SubResource("Pump"),SubResource("Delivery"),SubResource("Decoy"),SubResource("Public"),SubResource("Tanker")])
