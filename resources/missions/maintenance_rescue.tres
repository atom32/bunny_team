required = true
[resource]
script = ExtResource("1")
mission_id = &"maintenance_rescue"
display_name = "Sealed Maintenance / Do Not Hang Up"
description = "Unlatch the service bulkhead and open the ward. The central steam corridor cycles: clear for 2.4s, warning for 0.8s, hot for 1.6s. Use the clear window to cross and shut the far-side valve. You may clear it before releasing Xu Tang, or ask her to wait while you cross alone. She will not step into the marked corridor until the valve is closed. Then open the north shutter and bring her to the exit. South retreat stays open."
objective_definitions = Array[ExtResource("2")]([SubResource("O0"),SubResource("O1"),SubResource("O2"),SubResource("O3")])
